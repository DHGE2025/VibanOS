<Project Sdk="Cosmos.Sdk/3.0.99">

    <!-- VibanOS baut auf COSMOS 3.0 auf (User Kit 3.0.99, .NET 10). Bauen und starten: siehe README. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>VibanOS</RootNamespace>
        <!-- 'cosmos build' liest diese Zeile und baut damit auch auf ARM-Rechnern für x64, passend zu 'cosmos run'. -->
        <CosmosTargetArch>x64</CosmosTargetArch>
        <!-- Derselbe Code baut auch ohne COSMOS (tools/Preview), deshalb gelten die Voreinstellungen von normalem C#. -->
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cosmos.Kernel" Version="3.0.99" />
        <PackageReference Include="Cosmos.Kernel.System" Version="3.0.99" />
    </ItemGroup>

</Project>
