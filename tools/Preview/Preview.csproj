<Project Sdk="Microsoft.NET.Sdk">

    <!-- Baut den Kern und die Oberfläche von VibanOS ohne COSMOS als normales Konsolenprogramm.
         Prüft die Logik und schreibt Bildschirmfotos. Aufruf im Repo-Ordner: dotnet run mit Projekt tools/Preview -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net6.0</TargetFramework>
        <RollForward>Major</RollForward>
        <RootNamespace>VibanOS.Preview</RootNamespace>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\VibanOS\**\*.cs" Exclude="..\..\VibanOS\Kernel.cs;..\..\VibanOS\Platform\**;..\..\VibanOS\bin\**;..\..\VibanOS\obj\**" />
    </ItemGroup>

</Project>
